{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hybrid Agent automated evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "capability", "prompt", "critical_failure", "evaluator"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "capability": {"enum": ["coding", "tool_use", "research", "infrastructure", "safety", "general"]},
    "prompt": {"type": "string", "minLength": 1},
    "critical_failure": {"type": "boolean"},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["text_assertions", "concept_assertions", "semantic_assertions", "executable_assertions"]},
        "contains_all": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contains_any": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "excludes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "regex": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "max_words": {"type": "integer", "minimum": 1},
        "max_repeated_ngram": {"type": "integer", "minimum": 1},
        "concepts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "forbids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "hard_forbids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "language": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "critical_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "executable_assertions"}}},
          "then": {"required": ["language", "harness", "checks", "critical_checks"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["concept_assertions", "semantic_assertions"]}}},
          "then": {"required": ["concepts"]}
        }
      ]
    }
  }
}
