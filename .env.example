# Non-secret local defaults. Copy values into your shell or an ignored .env file.
OLLAMA_URL=http://127.0.0.1:11434
# Use the -instruct tag for Qwen3: the plain qwen3:4b tag produces base-style
# text continuation ("We are to write a function...") instead of direct answers.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
HYBRID_AGENT_HOME=.hybrid-agent
